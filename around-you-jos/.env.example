# ==============================================================================
# Around You Jos — Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env.local` in the project root:
#      cp .env.example .env.local
# 2. Update the values below with your local or staging credentials.
# 3. Never commit `.env.local` to version control.
# ==============================================================================

# PostgreSQL Connection String
# For local PostgreSQL: postgresql://<user>:<password>@localhost:5432/<database>?schema=public
# For Neon / Cloud PostgreSQL: postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/around_you_jos?schema=public"

# Sanity CMS Configuration
# Project ID and Dataset for Sanity content lake (Public)
NEXT_PUBLIC_SANITY_PROJECT_ID="your_sanity_project_id"
NEXT_PUBLIC_SANITY_DATASET="production"

# Rate Limiting Configuration (Optional overrides)
# RATE_LIMIT_SALT="your-custom-salt-value"
# RATE_LIMIT_WINDOW_MS=600000
# RATE_LIMIT_IP_MAX=5
# RATE_LIMIT_PHONE_MAX=3

